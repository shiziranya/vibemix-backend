# VibeMix Backend Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-secret-key-change-this
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ACCESS_TOKEN_EXPIRES=7200
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Database Configuration
SUPABASE_DATABASE_URL=postgresql://user:password@localhost:5432/vibemix

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# LLM Configuration
LLM_PROVIDER=doubao
ARK_API_KEY=your-doubao-api-key
DOUBAO_MODEL=doubao-seed-1-8-251228
DOUBAO_LLM_TIMEOUT=60
DOUBAO_MAX_TOKENS=1200
DOUBAO_REASONING_EFFORT=minimal

# Alternative LLM: DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_LLM_TIMEOUT=60
DEEPSEEK_MAX_TOKENS=1200
DEEPSEEK_REASONING_EFFORT=

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_STORAGE_BUCKET=vibemix

# Base URL (IMPORTANT: Update this for HTTPS)
# Development:
# BASE_URL=http://localhost:5005
# Production:
BASE_URL=https://yourdomain.com

# WeChat Mini Program
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# CORS Configuration
# For production, specify your frontend domain:
CORS_ORIGINS=https://your-frontend-domain.com
# For development, use wildcard:
# CORS_ORIGINS=*

# Card Generation Service
# Use internal HTTP for service-to-service communication:
CARD_GEN_SERVICE_URL=http://localhost:8001
CARD_GEN_TIMEOUT=60
